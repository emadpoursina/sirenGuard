{
  "manifest_version": 3,
  "name": "Siren Guard",
  "version": "0.1.0",
  "description": "Reports flagged website visits to the Siren Guard desktop app.",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
